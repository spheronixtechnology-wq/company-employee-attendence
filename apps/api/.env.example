# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/attendance?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=3h

# ─── Frontend Origins (Single Source of Truth for CORS & Socket.io) ───────────
# Production Frontend URLs
FRONTEND_ADMIN_URL=https://admin.spheronixtechnology.in
FRONTEND_MANAGER_URL=https://manager.spheronixtechnology.in
FRONTEND_EMPLOYEE_URL=https://employee.spheronixtechnology.in

# Local Development Frontend URLs
FRONTEND_ADMIN_LOCAL_URL=http://localhost:3000
FRONTEND_MANAGER_LOCAL_URL=http://localhost:3001
FRONTEND_EMPLOYEE_LOCAL_URL=http://localhost:3002

# Optional extra origins (comma-separated, for backward compatibility / tunnels)
# CORS_ORIGINS=

# ─── Cookie Configuration ────────────────────────────────────────────────────
# Leave empty for local development (enables host-only cookies)
# In production set: COOKIE_DOMAIN=.spheronixtechnology.in
COOKIE_DOMAIN=

# ─── WebAuthn (Biometric Passkeys) ───────────────────────────────────────────
# Explicit list of origins permitted to execute WebAuthn registration/auth.
# Strictly employee origins by default.
WEBAUTHN_ORIGINS=https://employee.spheronixtechnology.in,http://localhost:3002,https://localhost:3002
EXPECTED_ORIGIN=https://employee.spheronixtechnology.in
RP_ID=spheronixtechnology.in
RP_NAME=Spheronix Attendance System

# ─── Office QR Signing ────────────────────────────────────────────────────────
OFFICE_QR_SECRET=your_office_qr_secret_here

# ─── Seed Script Defaults ────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@spheronixtechnology.in
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=Super Admin
